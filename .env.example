# Veyra Environment Configuration Examples
#
# Production on Vercel:
# Frontend and FastAPI backend are deployed on the same domain.
# No environment variables are strictly required for production deployment.

# (Optional) Frontend API Base URL override.
# Leave empty or omitted in Vercel to use same-origin relative '/api' calls.
# In local standalone development without Vite proxy, you can set:
# VITE_API_URL=http://localhost:8000/api
VITE_API_URL=

# (Optional) Backend custom allowed CORS origin.
# Useful if hosting frontend on a separate custom domain.
# FRONTEND_URL=https://your-custom-domain.com
FRONTEND_URL=
